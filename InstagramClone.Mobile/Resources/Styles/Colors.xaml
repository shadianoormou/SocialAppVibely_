<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="Primary">#9B7BFF</Color>
    <Color x:Key="PrimaryDark">#7256D8</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#F0B7D0</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>
    <Color x:Key="Tertiary">#D6B36A</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#08080C</Color>
    <Color x:Key="MidnightBlue">#15121D</Color>
    <Color x:Key="OffBlack">#111116</Color>
    <Color x:Key="Surface">#15151D</Color>
    <Color x:Key="SurfaceElevated">#1C1B25</Color>
    <Color x:Key="SurfaceSoft">#25232F</Color>
    <Color x:Key="TextMuted">#A8A3B3</Color>
    <Color x:Key="Line">#2D2A38</Color>
    <Color x:Key="Gray100">#F0EEF5</Color>
    <Color x:Key="Gray200">#D8D4E1</Color>
    <Color x:Key="Gray300">#B3AEC1</Color>
    <Color x:Key="Gray400">#8D879D</Color>
    <Color x:Key="Gray500">#6E687D</Color>
    <Color x:Key="Gray600">#514D5D</Color>
    <Color x:Key="Gray900">#262330</Color>
    <Color x:Key="Gray950">#0D0D12</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
</ResourceDictionary>
