<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InstagramClone.Mobile.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    BackgroundColor="#07070D"
    Shell.NavBarIsVisible="False">

    <Grid x:Name="SplashRoot" BackgroundColor="#07070D">
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.00" Color="#07070D" />
                    <GradientStop Offset="0.45" Color="#120D1D" />
                    <GradientStop Offset="0.78" Color="#0D0915" />
                    <GradientStop Offset="1.00" Color="#050508" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <shapes:Ellipse
            x:Name="OuterHalo"
            WidthRequest="410"
            HeightRequest="410"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Fill="#0C9B7BFF"
            Stroke="#259B7BFF"
            StrokeThickness="1" />

        <shapes:Ellipse
            x:Name="InnerHalo"
            WidthRequest="270"
            HeightRequest="270"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Fill="#12D9B56D"
            Stroke="#30D9B56D"
            StrokeThickness="1" />

        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="18"
            Padding="24,0">

            <Grid
                x:Name="BrandIcon"
                WidthRequest="132"
                HeightRequest="132"
                HorizontalOptions="Center">
                <Border
                    Margin="4"
                    BackgroundColor="#171225"
                    Stroke="#B78BFF"
                    StrokeThickness="1.2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="38" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#A86E4BFF" Offset="0,12" Radius="25" Opacity="0.75" />
                    </Border.Shadow>
                </Border>
                <Border
                    Margin="12"
                    BackgroundColor="#0D0B14"
                    Stroke="#38FFFFFF"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="31" />
                    </Border.StrokeShape>
                </Border>
                <Image
                    Source="vibely_icon.png"
                    WidthRequest="100"
                    HeightRequest="100"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Vibely icon" />
            </Grid>

            <VerticalStackLayout x:Name="BrandLockup" Spacing="8" HorizontalOptions="Center">
                <Label
                    x:Name="BrandWordmark"
                    Text="Vibely"
                    FontFamily="OpenSansSemibold"
                    FontSize="48"
                    FontAttributes="Bold"
                    CharacterSpacing="1.2"
                    TextColor="#F9F0FA"
                    HorizontalTextAlignment="Center" />
                <Grid
                    x:Name="AccentLine"
                    WidthRequest="72"
                    HeightRequest="2"
                    HorizontalOptions="Center">
                    <BoxView CornerRadius="1">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#9B7BFF" />
                                <GradientStop Offset="0.5" Color="#D9B56D" />
                                <GradientStop Offset="1" Color="#F0A6D5" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                </Grid>
            </VerticalStackLayout>

            <Label
                x:Name="Tagline"
                Text="Your visual world, beautifully connected."
                TextColor="#D5CBDD"
                FontFamily="OpenSansRegular"
                FontSize="15"
                CharacterSpacing="0.45"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Label
            x:Name="LoadingLabel"
            Text="CREATE  •  CONNECT  •  INSPIRE"
            Margin="0,0,0,42"
            VerticalOptions="End"
            HorizontalOptions="Center"
            FontFamily="OpenSansSemibold"
            FontSize="9"
            CharacterSpacing="2.1"
            TextColor="#6E687D" />
    </Grid>
</ContentPage>
