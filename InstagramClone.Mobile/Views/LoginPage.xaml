<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InstagramClone.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#08080D"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#08080D" Offset="0" />
                <GradientStop Color="#151023" Offset="0.48" />
                <GradientStop Color="#09090F" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse
            x:Name="TopGlow"
            WidthRequest="330"
            HeightRequest="330"
            TranslationX="-150"
            TranslationY="-170"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Opacity="0.28"
            Fill="#9B7BFF" />
        <Ellipse
            x:Name="BottomGlow"
            WidthRequest="300"
            HeightRequest="300"
            TranslationX="150"
            TranslationY="210"
            HorizontalOptions="End"
            VerticalOptions="End"
            Opacity="0.20"
            Fill="#F09AD5" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="26,34,26,30" Spacing="20">
                <VerticalStackLayout
                    x:Name="BrandSection"
                    HorizontalOptions="Center"
                    Spacing="11"
                    Opacity="0"
                    TranslationY="-20">
                    <Grid
                        x:Name="BrandLogo"
                        WidthRequest="92"
                        HeightRequest="92"
                        HorizontalOptions="Center">
                        <Border
                            Margin="3"
                            BackgroundColor="#1A122A"
                            Stroke="#A77BFF"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#887B3AED" Offset="0,9" Radius="19" Opacity="0.72" />
                            </Border.Shadow>
                        </Border>
                        <Image
                            Source="vibely_icon.png"
                            WidthRequest="72"
                            HeightRequest="72"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                    <Label
                        x:Name="BrandWordmark"
                        Text="Vibely"
                        FontFamily="OpenSansSemibold"
                        FontSize="38"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#F8F1FA"
                        HorizontalTextAlignment="Center" />
                    <Border
                        x:Name="BrandAccent"
                        WidthRequest="58"
                        HeightRequest="2"
                        HorizontalOptions="Center"
                        StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#9B7BFF" Offset="0" />
                                <GradientStop Color="#D9B56D" Offset="0.5" />
                                <GradientStop Color="#F0A6D5" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="2" />
                        </Border.StrokeShape>
                    </Border>
                    <Label
                        Text="CREATE  •  CONNECT  •  INSPIRE"
                        FontFamily="OpenSansSemibold"
                        FontSize="9"
                        CharacterSpacing="2"
                        TextColor="#8E869C"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border
                    x:Name="LoginCard"
                    Padding="22"
                    Opacity="0"
                    Scale="0.96"
                    TranslationY="24"
                    BackgroundColor="#E6171721"
                    Stroke="#34FFFFFF"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#A0000000" Offset="0,14" Radius="28" Opacity="0.7" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Welcome back" FontFamily="OpenSansSemibold" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Label Text="Sign in to continue your visual world." FontSize="13" TextColor="#AAA3B4" />
                        </VerticalStackLayout>

                        <Border HeightRequest="58" Padding="15,2" BackgroundColor="#171720" Stroke="#3B3748" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Entry x:Name="EmailEntry" Placeholder="Email or username" PlaceholderColor="#767180" TextColor="#FFFFFF" FontSize="15" ClearButtonVisibility="WhileEditing" ReturnType="Next" />
                        </Border>

                        <Border HeightRequest="58" Padding="15,2" BackgroundColor="#171720" Stroke="#3B3748" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="PasswordEntry" Grid.Column="0" Placeholder="Password" PlaceholderColor="#767180" TextColor="#FFFFFF" FontSize="15" BackgroundColor="Transparent" IsPassword="True" ReturnType="Go" />
                                <Button x:Name="PasswordToggleButton" Grid.Column="1" Text="Show" FontSize="12" FontAttributes="Bold" TextColor="#CDBDFF" BackgroundColor="Transparent" Padding="8,0" Clicked="PasswordToggleButton_Clicked" />
                            </Grid>
                        </Border>

                        <Label Text="Forgot password?" FontSize="13" FontAttributes="Bold" TextColor="#CDBDFF" HorizontalOptions="End" />

                        <Button
                            x:Name="LoginButton"
                            Text="Sign in"
                            HeightRequest="56"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"
                            CornerRadius="17"
                            Clicked="LoginButton_Clicked">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7956E8" Offset="0" />
                                    <GradientStop Color="#A06AF2" Offset="0.52" />
                                    <GradientStop Color="#E77ABF" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Shadow>
                                <Shadow Brush="#887B5CF6" Offset="0,8" Radius="17" Opacity="0.8" />
                            </Button.Shadow>
                        </Button>

                        <ActivityIndicator x:Name="LoginActivityIndicator" IsVisible="False" IsRunning="False" Color="#D2C4FF" HorizontalOptions="Center" />

                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,2,0,0">
                            <BoxView Grid.Column="0" HeightRequest="1" Color="#3A3744" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="or continue with" FontSize="11" TextColor="#777181" />
                            <BoxView Grid.Column="2" HeightRequest="1" Color="#3A3744" VerticalOptions="Center" />
                        </Grid>

                        <Border x:Name="GoogleLoginCard" HeightRequest="56" Padding="15,0" BackgroundColor="#FFFFFF" Stroke="#E4E4E7" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="GoogleLogin_Tapped" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" BackgroundColor="#FFFFFF" Stroke="#D8D8DD" StrokeThickness="1" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="G" FontFamily="OpenSansSemibold" FontSize="20" FontAttributes="Bold" TextColor="#4285F4" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="Continue with Google" FontSize="14" FontAttributes="Bold" TextColor="#18181B" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="FacebookLoginCard" HeightRequest="56" Padding="15,0" BackgroundColor="#1877F2" Stroke="#5E9EFF" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="FacebookLogin_Tapped" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" BackgroundColor="#FFFFFF" StrokeThickness="0" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="f" FontFamily="OpenSansSemibold" FontSize="23" FontAttributes="Bold" TextColor="#1877F2" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="Continue with Facebook" FontSize="14" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="PhoneLoginCard" HeightRequest="56" Padding="15,0" BackgroundColor="#17151F" Stroke="#514366" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="PhoneLogin_Tapped" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" BackgroundColor="#29213A" Stroke="#8060D2" StrokeThickness="1" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="+" FontSize="21" FontAttributes="Bold" TextColor="#E5C8E8" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="Continue with phone number" FontSize="14" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,3,0,0">
                            <Label Text="New to Vibely?" TextColor="#AAA3B4" VerticalOptions="Center" />
                            <Label Text="Create account" TextColor="#D0C0FF" FontAttributes="Bold" VerticalOptions="Center">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="Register_Tapped" /></Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        <Label Text="Explore Vibely as a guest  →" TextColor="#E2A9D6" FontAttributes="Bold" HorizontalOptions="Center">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="Guest_Tapped" /></Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Label Text="By continuing, you agree to Vibely's Terms and Privacy Policy." FontSize="10.5" TextColor="#777181" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
