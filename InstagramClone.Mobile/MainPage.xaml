<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="InstagramClone.Mobile.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#0B0A10"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">
                <Grid Padding="20,24,18,14" ColumnDefinitions="*,Auto,Auto">
                    <VerticalStackLayout Spacing="1">
                        <Image Source="vibely-logo.png" WidthRequest="128" HeightRequest="42" Aspect="AspectFit" HorizontalOptions="Start" />
                        <Label x:Name="ContextLabel" Text="Your visual world" FontSize="11" TextColor="#A8A3B3" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="⌕" FontSize="27" TextColor="White" BackgroundColor="#1C1B25" Padding="0" Margin="0,0,8,0" Clicked="SearchButton_Clicked" />
                    <Button Grid.Column="2" Text="♢" FontSize="23" TextColor="White" BackgroundColor="#1C1B25" Padding="0" Clicked="MessagesButton_Clicked" />
                </Grid>
                <Grid x:Name="SearchPanel" IsVisible="False" Padding="18,0,18,14" ColumnDefinitions="*,Auto">
                    <Border BackgroundColor="#1C1B25" Stroke="#3A3448" StrokeThickness="1" Padding="14,0"><Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape><Entry x:Name="SearchEntry" Placeholder="Search creators, places, moods" PlaceholderColor="#777181" TextColor="White" FontSize="14" /></Border>
                    <Button Grid.Column="1" Text="×" FontSize="24" TextColor="#A8A3B3" BackgroundColor="Transparent" Padding="10,0" Clicked="CloseSearchButton_Clicked" />
                </Grid>

                <Grid x:Name="HomeView">
                    <VerticalStackLayout x:Name="StaticHomeContent" Spacing="0">
                        <Border Margin="18,3,18,18" Padding="14,16" BackgroundColor="#17151F" Stroke="#352A48" StrokeThickness="1"><Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border WidthRequest="48" HeightRequest="48" BackgroundColor="#2D223A" Stroke="#A855F7" StrokeThickness="1"><Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=12" /></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="Share a little magic" TextColor="White" FontFamily="OpenSansSemibold" FontSize="14" /><Label Text="What is inspiring you today?" TextColor="#A8A3B3" FontSize="12" /></VerticalStackLayout><Button Grid.Column="2" Text="＋" FontSize="27" TextColor="#F9A8D4" BackgroundColor="Transparent" Padding="8,0" Clicked="CreatePostButton_Clicked" /></Grid></Border>
                        <Grid Padding="20,0,18,12" ColumnDefinitions="*,Auto"><Label Text="Stories" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="18" TextColor="White" /><Label Grid.Column="1" Text="See all  ›" FontSize="12" TextColor="#C4B5FD" /></Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"><HorizontalStackLayout Padding="18,0,18,22" Spacing="16">
                            <VerticalStackLayout WidthRequest="64" Spacing="7"><Border WidthRequest="64" HeightRequest="64" BackgroundColor="#211B2D" Stroke="#9B7BFF" StrokeThickness="2"><Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=12" /></Border><Label Text="Your story" FontSize="10" TextColor="#A8A3B3" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                            <VerticalStackLayout WidthRequest="64" Spacing="7"><Border WidthRequest="64" HeightRequest="64" Padding="3" Stroke="#F0B7D0" StrokeThickness="2"><Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=47" /></Border><Label Text="Maya" FontSize="10" TextColor="White" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                            <VerticalStackLayout WidthRequest="64" Spacing="7"><Border WidthRequest="64" HeightRequest="64" Padding="3" Stroke="#F59E0B" StrokeThickness="2"><Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=32" /></Border><Label Text="Arif" FontSize="10" TextColor="White" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                            <VerticalStackLayout WidthRequest="64" Spacing="7"><Border WidthRequest="64" HeightRequest="64" Padding="3" Stroke="#EC4899" StrokeThickness="2"><Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=5" /></Border><Label Text="Sienna" FontSize="10" TextColor="White" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                            <VerticalStackLayout WidthRequest="64" Spacing="7"><Border WidthRequest="64" HeightRequest="64" Padding="3" Stroke="#9B7BFF" StrokeThickness="2"><Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=68" /></Border><Label Text="Noah" FontSize="10" TextColor="White" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                        </HorizontalStackLayout></ScrollView>
                        <Border Margin="12,0,12,22" BackgroundColor="#15151D" Stroke="#272532" StrokeThickness="1"><Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape><VerticalStackLayout Spacing="0">
                            <Grid Padding="15,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Border WidthRequest="42" HeightRequest="42" Stroke="#C4B5FD" StrokeThickness="1"><Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=47" /></Border><VerticalStackLayout Grid.Column="1"><Label Text="maya.rahman" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="13" TextColor="White" /><Label Text="Dhaka · 18 min ago" FontSize="11" TextColor="#8D879D" /></VerticalStackLayout><Button Grid.Column="2" Text="•••" FontSize="17" TextColor="#A8A3B3" BackgroundColor="Transparent" Padding="8,0" Clicked="MoreButton_Clicked" /></Grid>
                            <Grid HeightRequest="350"><Image Source="https://images.unsplash.com/photo-1519741497674-611481863552" Aspect="AspectFill" /><Border Margin="15" Padding="10,6" BackgroundColor="#AA111017" Stroke="#40FFFFFF" StrokeThickness="1" HorizontalOptions="Start" VerticalOptions="Start"><Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape><Label Text="✦  EDITOR'S PICK" TextColor="White" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.2" /></Border></Grid>
                            <Grid Padding="15,12,15,2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="13"><Button x:Name="LikeButton1" Text="♡" FontSize="28" TextColor="White" BackgroundColor="Transparent" Padding="0" Clicked="LikeButton1_Clicked" /><Button Grid.Column="1" Text="◌" FontSize="27" TextColor="White" BackgroundColor="Transparent" Padding="0" Clicked="CommentButton_Clicked" /><Button Grid.Column="2" Text="⌁" FontSize="27" TextColor="White" BackgroundColor="Transparent" Padding="0" Clicked="ShareButton_Clicked" /><BoxView Grid.Column="3" /><Button x:Name="SaveButton1" Grid.Column="4" Text="♧" FontSize="27" TextColor="White" BackgroundColor="Transparent" Padding="0" Clicked="SaveButton1_Clicked" /></Grid>
                            <VerticalStackLayout Padding="15,0,15,17" Spacing="5"><Label x:Name="LikesLabel1" Text="Liked by 2,846 people" TextColor="White" FontAttributes="Bold" FontSize="12" /><Label Text="maya.rahman  There is beauty in the in-between moments. ✨" TextColor="#E9E6EF" FontSize="13" /><Label Text="View all 96 comments" TextColor="#8D879D" FontSize="12" /></VerticalStackLayout>
                        </VerticalStackLayout></Border>
                        <Border Margin="12,0,12,30" BackgroundColor="#15151D" Stroke="#272532" StrokeThickness="1"><Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape><VerticalStackLayout Spacing="0"><Grid Padding="15,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Border WidthRequest="42" HeightRequest="42" Stroke="#F0B7D0" StrokeThickness="1"><Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=32" /></Border><VerticalStackLayout Grid.Column="1"><Label Text="arif.studio" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="13" TextColor="White" /><Label Text="Cox's Bazar · 1 hr ago" FontSize="11" TextColor="#8D879D" /></VerticalStackLayout><Button Grid.Column="2" Text="•••" FontSize="17" TextColor="#A8A3B3" BackgroundColor="Transparent" Padding="8,0" Clicked="MoreButton_Clicked" /></Grid><Image HeightRequest="315" Source="https://images.unsplash.com/photo-1507525428034-b723cf961d3e" Aspect="AspectFill" /><Grid Padding="15,12,15,2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="13"><Button Text="♡" FontSize="28" TextColor="White" BackgroundColor="Transparent" Padding="0" Clicked="LikeButton2_Clicked" /><Button Grid.Column="1" Text="◌" FontSize="27" TextColor="White" BackgroundColor="Transparent" Padding="0" Clicked="CommentButton_Clicked" /><Button Grid.Column="2" Text="⌁" FontSize="27" TextColor="White" BackgroundColor="Transparent" Padding="0" Clicked="ShareButton_Clicked" /><BoxView Grid.Column="3" /><Button Grid.Column="4" Text="♧" FontSize="27" TextColor="White" BackgroundColor="Transparent" Padding="0" /></Grid><VerticalStackLayout Padding="15,0,15,17" Spacing="5"><Label Text="Liked by 1,203 people" TextColor="White" FontAttributes="Bold" FontSize="12" /><Label Text="arif.studio  Slow mornings, salt air, and nowhere else to be." TextColor="#E9E6EF" FontSize="13" /><Label Text="View all 42 comments" TextColor="#8D879D" FontSize="12" /></VerticalStackLayout></VerticalStackLayout></Border>
                    </VerticalStackLayout>
                </Grid>
                <Grid x:Name="ExploreView" IsVisible="False" Padding="18,8,18,30"><VerticalStackLayout Spacing="18"><Label Text="Discover" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="28" TextColor="White" /><Label Text="Find your next visual obsession." TextColor="#A8A3B3" FontSize="13" /><Border BackgroundColor="#1C1B25" Stroke="#3A3448" StrokeThickness="1" Padding="14,0"><Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape><Entry Placeholder="Search Vibely" PlaceholderColor="#777181" TextColor="White" FontSize="14" /></Border><HorizontalStackLayout Spacing="9"><Border BackgroundColor="#9B7BFF" StrokeThickness="0" Padding="15,8"><Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape><Label Text="For you" TextColor="White" FontSize="12" FontAttributes="Bold" /></Border><Border BackgroundColor="#1C1B25" Stroke="#302C3B" StrokeThickness="1" Padding="15,8"><Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape><Label Text="Travel" TextColor="#C9C3D4" FontSize="12" /></Border><Border BackgroundColor="#1C1B25" Stroke="#302C3B" StrokeThickness="1" Padding="15,8"><Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape><Label Text="Design" TextColor="#C9C3D4" FontSize="12" /></Border><Border BackgroundColor="#1C1B25" Stroke="#302C3B" StrokeThickness="1" Padding="15,8"><Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape><Label Text="Reels" TextColor="#D6B36A" FontSize="12" FontAttributes="Bold" /></Border></HorizontalStackLayout><Grid ColumnDefinitions="*,*" RowDefinitions="220,145,220" ColumnSpacing="6" RowSpacing="6"><Image Source="https://images.unsplash.com/photo-1497366811353-6870744d04b2" Aspect="AspectFill" /><Image Grid.Column="1" Source="https://images.unsplash.com/photo-1529139574466-a303027c1d8b" Aspect="AspectFill" /><Image Grid.Row="1" Source="https://images.unsplash.com/photo-1496747611176-843222e1e57c" Aspect="AspectFill" /><Image Grid.Row="1" Grid.Column="1" Source="https://images.unsplash.com/photo-1518005020951-eccb494ad742" Aspect="AspectFill" /><Image Grid.Row="2" Source="https://images.unsplash.com/photo-1511818966892-d7d671e672a2" Aspect="AspectFill" /><Image Grid.Row="2" Grid.Column="1" Source="https://images.unsplash.com/photo-1531058020387-3be344556be6" Aspect="AspectFill" /></Grid></VerticalStackLayout></Grid>
                <Grid x:Name="ActivityView" IsVisible="False" Padding="20,8,20,40"><VerticalStackLayout Spacing="22"><Label Text="Activity" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="28" TextColor="White" /><Label Text="Stay close to your people." TextColor="#A8A3B3" FontSize="13" /><Label Text="Today" TextColor="#8D879D" FontSize="12" FontAttributes="Bold" /><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border WidthRequest="48" HeightRequest="48" Stroke="#F0B7D0" StrokeThickness="1"><Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=47" /></Border><Label Grid.Column="1" Text="maya.rahman liked your story.&#10;18 min ago" TextColor="#E9E6EF" FontSize="13" VerticalTextAlignment="Center" /><Button Grid.Column="2" Text="View" TextColor="#C4B5FD" BackgroundColor="Transparent" FontAttributes="Bold" /></Grid><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border WidthRequest="48" HeightRequest="48" Stroke="#A855F7" StrokeThickness="1"><Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/100?img=5" /></Border><Label Grid.Column="1" Text="sienna.co started following you.&#10;1 hour ago" TextColor="#E9E6EF" FontSize="13" VerticalTextAlignment="Center" /><Button Grid.Column="2" Text="Follow" TextColor="White" BackgroundColor="#9B7BFF" CornerRadius="12" FontSize="11" Padding="12,4" /></Grid><Label Text="You're all caught up ✦" TextColor="#C9C3D4" FontSize="15" HorizontalOptions="Center" Margin="0,25,0,0" /></VerticalStackLayout></Grid>
                <Grid x:Name="ProfileView" IsVisible="False" Padding="20,8,20,40"><VerticalStackLayout Spacing="18"><Grid ColumnDefinitions="Auto,*,Auto"><Border WidthRequest="88" HeightRequest="88" Padding="3" Stroke="#A855F7" StrokeThickness="2"><Border.StrokeShape><RoundRectangle CornerRadius="31" /></Border.StrokeShape><Image Source="https://i.pravatar.cc/150?img=12" /></Border><VerticalStackLayout Grid.Column="1" Padding="16,2,0,0" Spacing="8"><Label Text="vibely.creator" TextColor="White" FontAttributes="Bold" FontSize="17" /><HorizontalStackLayout Spacing="20"><VerticalStackLayout><Label Text="24" TextColor="White" FontAttributes="Bold" FontSize="16" /><Label Text="Posts" TextColor="#A8A3B3" FontSize="10" /></VerticalStackLayout><VerticalStackLayout><Label Text="12.8K" TextColor="White" FontAttributes="Bold" FontSize="16" /><Label Text="Followers" TextColor="#A8A3B3" FontSize="10" /></VerticalStackLayout><VerticalStackLayout><Label Text="386" TextColor="White" FontAttributes="Bold" FontSize="16" /><Label Text="Following" TextColor="#A8A3B3" FontSize="10" /></VerticalStackLayout></HorizontalStackLayout></VerticalStackLayout><Button Grid.Column="2" Text="⚙" FontSize="21" TextColor="#A8A3B3" BackgroundColor="Transparent" Padding="2" Clicked="SettingsButton_Clicked" /></Grid><Label Text="Vibely creator · visual storyteller&#10;Curating quiet moments, bold spaces &amp; good energy.&#10;Dhaka / everywhere ✦" TextColor="#C9C3D4" FontSize="13" /><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Edit profile" TextColor="White" BackgroundColor="#1C1B25" BorderColor="#3A3448" BorderWidth="1" CornerRadius="13" FontSize="12" /><Button Grid.Column="1" Text="Share profile" TextColor="White" BackgroundColor="#1C1B25" BorderColor="#3A3448" BorderWidth="1" CornerRadius="13" FontSize="12" /></Grid><BoxView HeightRequest="1" BackgroundColor="#272532" /><Grid ColumnDefinitions="*,*,*"><Label Text="▦" TextColor="#C4B5FD" FontSize="23" HorizontalTextAlignment="Center" /><Label Grid.Column="1" Text="▤" TextColor="#6E687D" FontSize="21" HorizontalTextAlignment="Center" /><Label Grid.Column="2" Text="♙" TextColor="#6E687D" FontSize="21" HorizontalTextAlignment="Center" /></Grid><Grid ColumnDefinitions="*,*" RowDefinitions="130,130" ColumnSpacing="4" RowSpacing="4"><Image Source="https://images.unsplash.com/photo-1511818966892-d7d671e672a2" Aspect="AspectFill" /><Image Grid.Column="1" Source="https://images.unsplash.com/photo-1496747611176-843222e1e57c" Aspect="AspectFill" /><Image Grid.Row="1" Source="https://images.unsplash.com/photo-1507525428034-b723cf961d3e" Aspect="AspectFill" /><Image Grid.Row="1" Grid.Column="1" Source="https://images.unsplash.com/photo-1497366811353-6870744d04b2" Aspect="AspectFill" /></Grid><Button Text="Sign out" TextColor="#F0B7D0" BackgroundColor="Transparent" FontAttributes="Bold" Clicked="SignOutButton_Clicked" /></VerticalStackLayout></Grid>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="1" BackgroundColor="#14131B" Stroke="#2B2736" StrokeThickness="1" Padding="10,8,10,12"><Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape><Grid ColumnDefinitions="*,*,*,*,*"><Button x:Name="HomeNavButton" Text="⌂" FontSize="25" TextColor="#F9A8D4" BackgroundColor="Transparent" Padding="0" Clicked="HomeNavButton_Clicked" /><Button Grid.Column="1" Text="⌕" FontSize="27" TextColor="#777181" BackgroundColor="Transparent" Padding="0" Clicked="ExploreNavButton_Clicked" /><Border Grid.Column="2" WidthRequest="52" HeightRequest="42" BackgroundColor="#9B7BFF" StrokeThickness="0" HorizontalOptions="Center"><Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape><Button Text="＋" FontSize="26" TextColor="White" BackgroundColor="Transparent" Padding="0" Clicked="CreatePostButton_Clicked" /></Border><Button Grid.Column="3" Text="♡" FontSize="27" TextColor="#777181" BackgroundColor="Transparent" Padding="0" Clicked="ActivityNavButton_Clicked" /><Button Grid.Column="4" Text="♙" FontSize="26" TextColor="#777181" BackgroundColor="Transparent" Padding="0" Clicked="ProfileNavButton_Clicked" /></Grid></Border>
    </Grid>
</ContentPage>
